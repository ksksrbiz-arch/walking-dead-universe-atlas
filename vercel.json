{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {"source":"/api/atlas/bookmarks","destination":"https://qflqfvoxdzkibpzfrwop.supabase.co/functions/v1/atlas-bookmarks"},
    {"source":"/api/atlas/state","destination":"https://qflqfvoxdzkibpzfrwop.supabase.co/functions/v1/atlas-state"},
    {"source":"/api/atlas/media","destination":"https://qflqfvoxdzkibpzfrwop.supabase.co/functions/v1/atlas-media"}
  ],
  "headers":[
    {"source":"/assets/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/data/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=86400, stale-while-revalidate=604800"}]}
  ]
}