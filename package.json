{
  "name": "walking-dead-universe-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run ingest:media && npm run ensure:fandom-canonical && npm run cache:media && vite build",
    "preview": "vite preview",
    "ingest:media": "node scripts/ingest-amc-media.mjs",
    "audit:atlas": "node scripts/audit-atlas.mjs",
    "build:with-media": "npm run ingest:media && npm run ensure:fandom-canonical && npm run cache:media && npm run audit:atlas && vite build",
    "cache:media": "node scripts/cache-amc-media.mjs",
    "enrich:probe": "node scripts/enrich-atlas.mjs --probe",
    "enrich:fandom": "node scripts/enrich-atlas.mjs --fandom-characters",
    "enrich:all": "npm run enrich:probe && npm run enrich:fandom-full",
    "enrich:fandom-atlas": "node scripts/ingest-fandom-atlas.mjs",
    "enrich:fandom-pages": "node scripts/enrich-fandom-pages.mjs",
    "enrich:fandom-full": "npm run enrich:fandom-atlas && npm run enrich:fandom-pages && npm run reconcile:fandom && npm run publish:fandom-canonical && npm run promote:fandom-media",
    "publish:fandom-canonical": "node scripts/publish-fandom-canonical.mjs",
    "audit:enrichment": "node scripts/audit-fandom-enrichment.mjs",
    "audit:media-quality": "node scripts/audit-media-quality.mjs",
    "publish:enrichment-preview": "node scripts/publish-enrichment-preview.mjs",
    "reconcile:fandom": "node scripts/reconcile-fandom-matches.mjs",
    "promote:fandom-media": "node scripts/promote-fandom-media.mjs",
    "ensure:fandom-canonical": "node scripts/ensure-fandom-canonical.mjs",
    "enrich:fandom-netlify": "node scripts/run-fandom-enrichment-netlify.mjs",
    "ensure:fandom-artifacts": "node scripts/ensure-fandom-artifacts.mjs",
    "enrich:fandom-galleries": "node scripts/enrich-fandom-galleries.mjs",
    "ingest:amc-media-exhaustive": "node scripts/ingest-amc-media-exhaustive.mjs",
    "build:enrichment": "npm run ingest:media && npm run ensure:fandom-canonical && npm run cache:media && npm run audit:atlas && vite build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "@cublya/world-atlas": "^3.0.0-beta.1",
    "@netlify/functions": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "@types/topojson-client": "^3.1.5",
    "@types/d3-geo": "^3.1.1"
  }
}
